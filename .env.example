# Postgres connection string for the database the storefront and the admin
# panel share.
DATABASE_URL=

# Canonical origin used for metadata, hreflang links and the sitemap. Defaults
# to https://ronascorduene.com, so it only needs setting for preview deploys.
NEXT_PUBLIC_SITE_URL=https://ronascorduene.com

# Shared secret for POST /api/revalidate. The admin panel sends it as the
# `x-revalidate-secret` header after every save so its edits show up here
# immediately; unset, the endpoint answers 503 and cached pages stay stale.
# Must match STOREFRONT_REVALIDATE_SECRET in the admin app.
REVALIDATE_SECRET=

# Google SMTP for the order emails (nodemailer). SMTP_PASS must be the
# 16-character Gmail App Password for SMTP_USER.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@ronascorduene.com
SMTP_PASS=
MAIL_FROM=info@ronascorduene.com
MAIL_FROM_NAME="Ronas Corduene"

# Shared secret for POST /api/orders/notify. The admin panel calls it with the
# `x-store-notify-secret` header when an order is marked as shipped; unset, the
# endpoint answers 401 and no shipped email is sent.
# Must match STOREFRONT_NOTIFY_SECRET in the admin app.
STORE_NOTIFY_SECRET=
